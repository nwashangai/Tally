# Tally Environment Configuration Template
# DO NOT commit the real .env file to version control.
# Only safe, public/anonymous keys belong in the client environment.
# NEVER put serverless service role secrets, master database credentials, or private API keys here.

# Environment
ENVIRONMENT=development # development | staging | production

# Serverless Backend (Pending ADR 0002)
# Example for Supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=public-anon-key-here
#
# Example for Firebase:
# FIREBASE_PROJECT_ID=tally-dev
# FIREBASE_API_KEY=public-api-key-here

# Advertising Service (Pending ADR 0003)
# AD_ENABLED=false
# ADMOB_APP_ID_IOS=
# ADMOB_APP_ID_ANDROID=
# ADMOB_BANNER_UNIT_ID=
